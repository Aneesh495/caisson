// Module: caisson::web
// Embedded single-page interactive administrative dashboard and operational console.
//
// Part of the Caisson distributed object storage engine.

module caisson::web;

fn String get_dashboard_html() {
    return "<!DOCTYPE html>\n"
           "<html lang=\"en\">\n"
           "<head>\n"
           "  <meta charset=\"UTF-8\" />\n"
           "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n"
           "  <title>Caisson | Distributed Object Storage Console</title>\n"
           "  <style>\n"
           "    :root {\n"
           "      --bg: #0d1117;\n"
           "      --panel: #161b22;\n"
           "      --border: #30363d;\n"
           "      --text: #c9d1d9;\n"
           "      --text-muted: #8b949e;\n"
           "      --accent: #58a6ff;\n"
           "      --success: #3fb950;\n"
           "      --warning: #d29922;\n"
           "      --danger: #f85149;\n"
           "      --font-mono: 'SF Mono', Consolas, Menlo, Monaco, monospace;\n"
           "    }\n"
           "    * { box-sizing: border-box; margin: 0; padding: 0; }\n"
           "    body {\n"
           "      background-color: var(--bg);\n"
           "      color: var(--text);\n"
           "      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\n"
           "      line-height: 1.5;\n"
           "      padding: 24px;\n"
           "    }\n"
           "    header {\n"
           "      display: flex;\n"
           "      justify-content: space-between;\n"
           "      align-items: center;\n"
           "      padding-bottom: 20px;\n"
           "      border-bottom: 1px solid var(--border);\n"
           "      margin-bottom: 24px;\n"
           "    }\n"
           "    .brand { display: flex; align-items: center; gap: 12px; }\n"
           "    .brand h1 { font-size: 20px; font-weight: 600; color: #fff; letter-spacing: -0.5px; }\n"
           "    .badge {\n"
           "      font-size: 11px;\n"
           "      font-weight: 600;\n"
           "      padding: 2px 8px;\n"
           "      border-radius: 12px;\n"
           "      background: rgba(63, 185, 80, 0.15);\n"
           "      color: var(--success);\n"
           "      border: 1px solid rgba(63, 185, 80, 0.4);\n"
           "    }\n"
           "    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px; }\n"
           "    .card {\n"
           "      background: var(--panel);\n"
           "      border: 1px solid var(--border);\n"
           "      border-radius: 8px;\n"
           "      padding: 16px;\n"
           "    }\n"
           "    .card-title { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; }\n"
           "    .card-value { font-size: 28px; font-weight: 700; color: #fff; font-family: var(--font-mono); }\n"
           "    .card-sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; }\n"
           "    section { margin-bottom: 32px; }\n"
           "    h2 { font-size: 16px; font-weight: 600; margin-bottom: 12px; color: #fff; }\n"
           "    table {\n"
           "      width: 100%;\n"
           "      border-collapse: collapse;\n"
           "      background: var(--panel);\n"
           "      border: 1px solid var(--border);\n"
           "      border-radius: 8px;\n"
           "      overflow: hidden;\n"
           "    }\n"
           "    th, td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); font-size: 13px; }\n"
           "    th { background: rgba(255, 255, 255, 0.02); color: var(--text-muted); font-weight: 600; }\n"
           "    code { font-family: var(--font-mono); font-size: 12px; background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; }\n"
           "    .playground {\n"
           "      background: var(--panel);\n"
           "      border: 1px solid var(--border);\n"
           "      border-radius: 8px;\n"
           "      padding: 20px;\n"
           "    }\n"
           "    .shards-grid { display: flex; gap: 12px; margin: 16px 0; flex-wrap: wrap; }\n"
           "    .shard-box {\n"
           "      flex: 1;\n"
           "      min-width: 90px;\n"
           "      padding: 16px 12px;\n"
           "      text-align: center;\n"
           "      border: 1px solid var(--border);\n"
           "      border-radius: 6px;\n"
           "      background: rgba(255,255,255,0.02);\n"
           "      cursor: pointer;\n"
           "      transition: all 0.2s ease;\n"
           "    }\n"
           "    .shard-box.healthy { border-color: rgba(63, 185, 80, 0.6); color: var(--success); }\n"
           "    .shard-box.failed { border-color: rgba(248, 81, 73, 0.6); background: rgba(248, 81, 73, 0.1); color: var(--danger); }\n"
           "    .shard-box.parity { border-style: dashed; }\n"
           "    .btn {\n"
           "      background: var(--accent);\n"
           "      color: #fff;\n"
           "      border: none;\n"
           "      padding: 8px 16px;\n"
           "      font-size: 13px;\n"
           "      font-weight: 600;\n"
           "      border-radius: 6px;\n"
           "      cursor: pointer;\n"
           "    }\n"
           "    .btn:hover { opacity: 0.9; }\n"
           "  </style>\n"
           "</head>\n"
           "<body>\n"
           "  <header>\n"
           "    <div class=\"brand\">\n"
           "      <h1>Caisson Storage Engine</h1>\n"
           "      <span class=\"badge\">ONLINE v1.0.0</span>\n"
           "    </div>\n"
           "    <div>\n"
           "      <code id=\"node-endpoint\">http://127.0.0.1:9000</code>\n"
           "    </div>\n"
           "  </header>\n"
           "\n"
           "  <div class=\"grid\">\n"
           "    <div class=\"card\">\n"
           "      <div class=\"card-title\">Active Storage Pool</div>\n"
           "      <div class=\"card-value\" id=\"drive-count\">6 Drives</div>\n"
           "      <div class=\"card-sub\">Consistent hash ring: 256 vnodes</div>\n"
           "    </div>\n"
           "    <div class=\"card\">\n"
           "      <div class=\"card-title\">Erasure Coding Layout</div>\n"
           "      <div class=\"card-value\">RS(4, 2)</div>\n"
           "      <div class=\"card-sub\">Fault tolerance: up to 2 shard losses</div>\n"
           "    </div>\n"
           "    <div class=\"card\">\n"
           "      <div class=\"card-title\">Bitcask Write Pipeline</div>\n"
           "      <div class=\"card-value\" id=\"stat-writes\">0 Writes</div>\n"
           "      <div class=\"card-sub\">Log-structured merge append WAL</div>\n"
           "    </div>\n"
           "    <div class=\"card\">\n"
           "      <div class=\"card-title\">Bit-Rot Scrubber</div>\n"
           "      <div class=\"card-value\" id=\"stat-scrub\">Active</div>\n"
           "      <div class=\"card-sub\">Automated CRC32C background verification</div>\n"
           "    </div>\n"
           "  </div>\n"
           "\n"
           "  <section class=\"playground\">\n"
           "    <h2>Interactive Reed-Solomon Fault Recovery Playground</h2>\n"
           "    <p style=\"font-size: 13px; color: var(--text-muted);\">\n"
           "      Click on shards below to simulate drive corruptions or failures. The Cauchy GF(2^8) engine will automatically reconstruct missing data once you click 'Heal Stripe'.\n"
           "    </p>\n"
           "    <div class=\"shards-grid\" id=\"shards-container\">\n"
           "      <div class=\"shard-box healthy\" onclick=\"toggleShard(0)\"><b>Data 0</b><br/><small>Healthy</small></div>\n"
           "      <div class=\"shard-box healthy\" onclick=\"toggleShard(1)\"><b>Data 1</b><br/><small>Healthy</small></div>\n"
           "      <div class=\"shard-box healthy\" onclick=\"toggleShard(2)\"><b>Data 2</b><br/><small>Healthy</small></div>\n"
           "      <div class=\"shard-box healthy\" onclick=\"toggleShard(3)\"><b>Data 3</b><br/><small>Healthy</small></div>\n"
           "      <div class=\"shard-box healthy parity\" onclick=\"toggleShard(4)\"><b>Parity 0</b><br/><small>Healthy</small></div>\n"
           "      <div class=\"shard-box healthy parity\" onclick=\"toggleShard(5)\"><b>Parity 1</b><br/><small>Healthy</small></div>\n"
           "    </div>\n"
           "    <div style=\"display: flex; gap: 12px; align-items: center;\">\n"
           "      <button class=\"btn\" onclick=\"healShards()\">Heal Stripe via Reed-Solomon</button>\n"
           "      <span id=\"heal-status\" style=\"font-size: 13px; font-weight: 600;\"></span>\n"
           "    </div>\n"
           "  </section>\n"
           "\n"
           "  <section style=\"margin-top: 24px;\">\n"
           "    <h2>S3 REST Protocol Compatibility</h2>\n"
           "    <table>\n"
           "      <thead>\n"
           "        <tr><th>Operation</th><th>HTTP Method</th><th>S3 Resource Path</th><th>Status</th></tr>\n"
           "      </thead>\n"
           "      <tbody>\n"
           "        <tr><td>ListAllMyBuckets</td><td><code>GET</code></td><td><code>/</code></td><td><span class=\"badge\">Supported</span></td></tr>\n"
           "        <tr><td>CreateBucket / DeleteBucket</td><td><code>PUT / DELETE</code></td><td><code>/&lt;bucket&gt;</code></td><td><span class=\"badge\">Supported</span></td></tr>\n"
           "        <tr><td>ListObjectsV2</td><td><code>GET</code></td><td><code>/&lt;bucket&gt;?list-type=2</code></td><td><span class=\"badge\">Supported</span></td></tr>\n"
           "        <tr><td>PutObject / GetObject / HeadObject</td><td><code>PUT / GET / HEAD</code></td><td><code>/&lt;bucket&gt;/&lt;key&gt;</code></td><td><span class=\"badge\">Supported</span></td></tr>\n"
           "        <tr><td>Byte Range Reads (RFC 7233)</td><td><code>GET (Range: bytes=X-Y)</code></td><td><code>/&lt;bucket&gt;/&lt;key&gt;</code></td><td><span class=\"badge\">Supported</span></td></tr>\n"
           "        <tr><td>Multipart Upload Lifecycle</td><td><code>POST / PUT / DELETE</code></td><td><code>/&lt;bucket&gt;/&lt;key&gt;?uploadId=X</code></td><td><span class=\"badge\">Supported</span></td></tr>\n"
           "        <tr><td>AWS SigV4 Authentication</td><td><code>Authorization Header</code></td><td><code>AWS4-HMAC-SHA256 ...</code></td><td><span class=\"badge\">Supported</span></td></tr>\n"
           "      </tbody>\n"
           "    </table>\n"
           "  </section>\n"
           "\n"
           "  <script>\n"
           "    const shardState = [true, true, true, true, true, true];\n"
           "    function toggleShard(idx) {\n"
           "      shardState[idx] = !shardState[idx];\n"
           "      renderShards();\n"
           "    }\n"
           "    function renderShards() {\n"
           "      const container = document.getElementById('shards-container');\n"
           "      const boxes = container.children;\n"
           "      let failedCount = 0;\n"
           "      for (let i = 0; i < 6; i++) {\n"
           "        const isData = i < 4;\n"
           "        const label = isData ? 'Data ' + i : 'Parity ' + (i - 4);\n"
           "        if (shardState[i]) {\n"
           "          boxes[i].className = 'shard-box healthy' + (isData ? '' : ' parity');\n"
           "          boxes[i].innerHTML = '<b>' + label + '</b><br/><small>Healthy</small>';\n"
           "        } else {\n"
           "          boxes[i].className = 'shard-box failed' + (isData ? '' : ' parity');\n"
           "          boxes[i].innerHTML = '<b>' + label + '</b><br/><small>FAILED</small>';\n"
           "          failedCount++;\n"
           "        }\n"
           "      }\n"
           "      const status = document.getElementById('heal-status');\n"
           "      if (failedCount > 2) {\n"
           "        status.style.color = 'var(--danger)';\n"
           "        status.innerText = failedCount + ' shards lost: Exceeds M=2 fault tolerance limit!';\n"
           "      } else if (failedCount > 0) {\n"
           "        status.style.color = 'var(--warning)';\n"
           "        status.innerText = failedCount + ' shards lost: Recoverable via RS(4, 2) parity matrix';\n"
           "      } else {\n"
           "        status.style.color = 'var(--success)';\n"
           "        status.innerText = 'Stripe is fully healthy (0 losses)';\n"
           "      }\n"
           "    }\n"
           "    function healShards() {\n"
           "      let failedCount = 0;\n"
           "      for (let i = 0; i < 6; i++) if (!shardState[i]) failedCount++;\n"
           "      if (failedCount > 2) {\n"
           "        alert('Cannot recover: more than 2 shards failed. Quorum lost.');\n"
           "        return;\n"
           "      }\n"
           "      for (let i = 0; i < 6; i++) shardState[i] = true;\n"
           "      renderShards();\n"
           "      document.getElementById('heal-status').style.color = 'var(--success)';\n"
           "      document.getElementById('heal-status').innerText = 'Successfully reconstructed shards via Gauss-Jordan elimination!';\n"
           "    }\n"
           "  </script>\n"
           "</body>\n"
           "</html>\n";
}
